{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // No maps: they point at `src/`, which is not published.
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  // Specs, and the fixtures only a spec reads: a user installs `dist`, and
  // nothing in it should be there for the tests. `tsconfig.json` still
  // typechecks both.
  "exclude": ["src/**/*.spec.ts", "src/agent/fixtures.ts"]
}
