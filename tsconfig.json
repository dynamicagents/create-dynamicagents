{
  "compilerOptions": {
    "target": "ES2024",
    // The pair core, plugins and every generated project use, and for the same
    // reason: nothing at run time resolves a specifier in this repo. `dist` is
    // one bundle, so esbuild is the only resolver in the path and relative
    // imports name a file without its extension. NodeNext stood here while
    // `dist` was 38 modules Node loaded itself; it cannot stand beside an
    // extensionless import, which it exists to refuse.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    // `@types/node` tracks `engines`, so an API newer than the oldest Node a
    // user may run fails here rather than on their machine.
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // Specs included, and nothing excluded: this project only typechecks —
  // `noEmit` above, and `npm run build` is esbuild — so there is no second
  // project to keep specs out of `dist`. A bundle rooted at `src/cli.ts`
  // cannot reach one: nothing it imports imports a spec.
  //
  // eslint needs them here besides. Its type-aware pass resolves each file to
  // its *nearest* tsconfig, so a co-located spec left out would have no
  // project at all and fail to parse.
  //
  // `vitest.config.ts` is named too, because it is the only source file outside
  // `src/` and the `.tpl` loader it declares is load-bearing for every spec.
  // The `.tpl` files themselves are not here and must not be: they are text,
  // and `src/agent/templates/tpl.d.ts` is what says so.
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
